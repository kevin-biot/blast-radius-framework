{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kevin-biot/blast-radius-framework/spec/execution-evidence.schema.json",
  "title": "Local Boundary Execution Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "generated_at", "scope", "observer", "authority_scope", "signed", "upstream", "artifacts", "cases", "expectations_met", "boundary_violation_cases"],
  "properties": {
    "schema_version": {"enum": ["0.1.0", "0.1.1"]},
    "kind": {"enum": ["acs_live", "async_boundary", "credential_boundary"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {"const": "local_fixed_proposal_mechanism_test"},
    "observer": {"const": "same_machine_read_only_sqlite"},
    "authority_scope": {"const": "fixture_runtime_grants_only"},
    "signed": {"const": false},
    "upstream": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["repository", "commit", "release", "bun"],
         "properties": {"repository": {"type": "string"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                        "release": {"type": "string"}, "bun": {"type": "string"}}}
      ]
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}}},
    "captures": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}}},
    "expectations_met": {"type": "boolean"},
    "boundary_violation_cases": {"type": "integer", "minimum": 0},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "allOf": [{"if": {"properties": {"kind": {"const": "credential_boundary"}}},
             "then": {"required": ["captures"], "properties": {"schema_version": {"const": "0.1.1"},
                       "cases": {"items": {"required": ["checks"]}}}}}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "decision", "expected_committed_amount", "observed_committed_amount", "expectation_met", "boundary_violation", "residual_amount", "receipts", "active", "budget", "spent"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "acs_request_id": {"type": "string", "format": "uuid"},
        "acs_session_id": {"type": "string", "format": "uuid"},
        "decision": {"enum": ["allow", "deny", "not_applicable"]},
        "expected_committed_amount": {"type": "integer", "minimum": 0},
        "observed_committed_amount": {"type": "integer", "minimum": 0},
        "expectation_met": {"type": "boolean"},
        "boundary_violation": {"type": "boolean"},
        "residual_amount": {"type": "integer", "minimum": 0},
        "active": {"type": "boolean"}, "budget": {"type": "integer", "minimum": 0}, "spent": {"type": "integer", "minimum": 0},
        "receipts": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["seq", "operation_id", "amount", "payload_hash", "committed_ns"],
          "properties": {"seq": {"type": "integer", "minimum": 1}, "operation_id": {"type": "string"},
                         "amount": {"type": "integer", "minimum": 1}, "payload_hash": {"$ref": "#/$defs/hash"},
                         "committed_ns": {"type": "integer", "minimum": 1}}}},
        "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}}
      }
    }
  }
}
