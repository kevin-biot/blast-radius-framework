{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kevin-biot/blast-radius-framework/spec/inventory-links.schema.json",
  "title": "CycloneDX inventory to BRF card link evidence",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source_format", "spec_version", "schema_commit", "sources", "inventory", "dependency_graph_declaration", "declared_dependencies", "external_refs_not_resolved", "unused_card_ids", "runtime_reach", "authority", "limits"],
  "properties": {
    "schema_version": {"const": "0.1.0"}, "generated_at": {"type": "string", "format": "date-time"},
    "source_format": {"const": "CycloneDX-JSON"}, "spec_version": {"const": "1.7"},
    "schema_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sources": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/source"}},
    "inventory": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["kind", "bom_ref", "name", "version", "purl", "link_status", "card_links", "dependency_declaration"],
      "properties": {
        "kind": {"enum": ["component", "service"]}, "bom_ref": {"type": ["string", "null"]},
        "name": {"type": "string"}, "version": {"type": ["string", "null"]}, "purl": {"type": ["string", "null"]},
        "link_status": {"enum": ["declared_unverified", "unmapped", "not_addressable"]},
        "dependency_declaration": {"enum": ["listed", "not_listed", "not_addressable"]},
        "card_links": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["card_id", "card_sha256", "profile_bindings"],
          "properties": {"card_id": {"type": "string"}, "card_sha256": {"$ref": "#/$defs/hash"},
            "profile_bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
              "required": ["profile_id", "sha256"], "properties": {"profile_id": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}}}
          }}}
      }}},
    "dependency_graph_declaration": {"enum": ["supplied", "not_supplied"]},
    "declared_dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["ref", "depends_on", "provides"], "properties": {"ref": {"type": "string"},
        "depends_on": {"type": "array", "items": {"type": "string"}}, "provides": {"type": "array", "items": {"type": "string"}}}}},
    "external_refs_not_resolved": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "unused_card_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "runtime_reach": {"const": "not_established"}, "authority": {"const": "not_established"},
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["role", "name", "sha256"],
      "properties": {"role": {"enum": ["bom", "mapping", "card", "profile"]}, "name": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}}
  }
}
