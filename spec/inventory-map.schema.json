{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit CycloneDX to BRF component-card mappings",
  "type": "object", "additionalProperties": false, "required": ["links"],
  "properties": {"links": {"type": "array", "uniqueItems": true, "items": {
    "type": "object", "additionalProperties": false, "required": ["bom_ref", "card_id"],
    "properties": {"bom_ref": {"type": "string", "minLength": 1}, "card_id": {"type": "string", "minLength": 1}}
  }}}
}
