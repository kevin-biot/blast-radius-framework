{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credential boundary fixture context (no bearer credentials)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at", "issuer", "audience", "trusted_key_sha256", "library", "mandate_status", "observation_scope", "records", "limits"],
  "properties": {
    "schema_version": {"const": "0.1.0"}, "generated_at": {"type": "string", "format": "date-time"},
    "issuer": {"type": "string"}, "audience": {"type": "string"}, "trusted_key_sha256": {"$ref": "#/$defs/hash"},
    "library": {"type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"const": "PyJWT"}, "version": {"type": "string"}}},
    "mandate_status": {"const": "not_established"}, "observation_scope": {"const": "same_machine_fixture"},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["case_id", "mode", "http_statuses", "error_reasons", "credential_ids_sha256", "tenant_balances", "receipts"],
      "properties": {
        "case_id": {"type": "string"}, "mode": {"enum": ["commit_recheck", "admission_only"]},
        "http_statuses": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 100, "maximum": 599}},
        "error_reasons": {"type": "array", "items": {"type": "string"}},
        "credential_ids_sha256": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
        "tenant_balances": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false,
          "required": ["tenant", "active", "budget", "spent"], "properties": {"tenant": {"enum": ["alpha", "beta"]},
            "active": {"type": "boolean"}, "budget": {"type": "integer", "minimum": 0}, "spent": {"type": "integer", "minimum": 0}}}},
        "receipts": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["seq", "tenant", "principal", "client_id", "operation_id", "amount", "payload_hash", "credential_id", "committed_ns"],
          "properties": {"seq": {"type": "integer", "minimum": 1}, "tenant": {"enum": ["alpha", "beta"]},
            "principal": {"type": "string"}, "client_id": {"type": "string"}, "operation_id": {"type": "string"},
            "amount": {"type": "integer", "minimum": 1}, "payload_hash": {"$ref": "#/$defs/hash"},
            "credential_id": {"$ref": "#/$defs/hash"}, "committed_ns": {"type": "integer", "minimum": 1}}}}
      }}},
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
