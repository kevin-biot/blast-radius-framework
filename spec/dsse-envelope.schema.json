{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kevin-biot/blast-radius-framework/spec/dsse-envelope.schema.json",
  "title": "DSSE JSON Envelope (BRF reader limits)",
  "type": "object",
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": {"type": "string", "minLength": 1},
    "payload": {"type": "string", "minLength": 1},
    "signatures": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
      "type": "object", "required": ["sig"],
      "properties": {"sig": {"type": "string", "minLength": 1}, "keyid": {"type": "string"}}
    }}
  }
}
