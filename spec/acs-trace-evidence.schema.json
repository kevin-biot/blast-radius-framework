{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kevin-biot/blast-radius-framework/spec/acs-trace-evidence.schema.json",
  "title": "BRF ACS Trace Analysis (not enforcement proof)",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "source_format", "upstream_commit", "mapping_sha256", "created_at", "sources", "records", "ignored_span_count", "failure_pair_count", "analysis_status", "limits"],
  "properties": {
    "bundle_version": {"const": "0.1"},
    "source_format": {"const": "ACS-OTLP-JSON"},
    "upstream_commit": {"const": "834f3f0d51e7bbbd9a68ff682bec89f97ddd72d8"},
    "mapping_sha256": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"},
    "sources": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}}
    }},
    "ignored_span_count": {"type": "integer", "minimum": 0},
    "failure_pair_count": {"type": "integer", "minimum": 0},
    "analysis_status": {"enum": ["consistent", "findings"]},
    "records": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "request_id", "span_names", "claimed_services", "verdicts", "reported_chain_hashes", "policy_references", "failures", "reported_tool_results", "tool_result_request_refs", "findings", "decision_usable_as_reported", "enforcement_status"],
      "properties": {
        "session_id": {"type": "string", "format": "uuid"},
        "request_id": {"type": "string", "format": "uuid"},
        "span_names": {"$ref": "#/$defs/strings"},
        "claimed_services": {"$ref": "#/$defs/strings"},
        "verdicts": {"type": "array", "uniqueItems": true, "items": {"enum": ["allow", "deny", "modify", "ask", "defer"]}},
        "reported_chain_hashes": {"$ref": "#/$defs/strings"},
        "tool_result_request_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
        "policy_references": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["policy_id", "policy_version", "rule_id"],
          "properties": {"policy_id": {"type": "string"}, "policy_version": {"type": "string"}, "rule_id": {"type": "string"}}
        }},
        "failures": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["class", "posture", "reported_by"],
          "properties": {"class": {"type": "string"}, "posture": {"enum": ["fail_open", "fail_closed"]}, "reported_by": {"enum": ["guardian", "observed_agent"]}}
        }},
        "reported_tool_results": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["request_id_ref", "result_request_id", "tool", "exit_status"],
          "properties": {"request_id_ref": {"type": "string", "format": "uuid"}, "result_request_id": {"type": "string", "format": "uuid"}, "tool": {"type": "string"}, "exit_status": {"type": "string"}}
        }},
        "findings": {"$ref": "#/$defs/strings"},
        "decision_usable_as_reported": {"type": "boolean"},
        "enforcement_status": {"const": "not_verified"}
      }
    }},
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
