{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kevin-biot/blast-radius-framework/spec/acs-evidence.schema.json",
  "title": "BRF ACS Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "source_kind", "created_at", "upstream_commit", "input_sha256", "policy_snapshot_id", "target_revision", "evaluation_status", "records", "brf_evidence_relevance", "limits"],
  "properties": {
    "bundle_version": {"const": "0.1"},
    "source_kind": {"enum": ["local_fixture", "captured_acs"]},
    "created_at": {"type": "string", "format": "date-time"},
    "upstream_commit": {"const": "834f3f0d51e7bbbd9a68ff682bec89f97ddd72d8"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_snapshot_id": {"type": "string", "minLength": 1},
    "target_revision": {"type": "string", "minLength": 1},
    "evaluation_status": {"enum": ["pass", "fail", "inconclusive"]},
    "records": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "session_id", "decision", "executed", "outcome", "policy_bound", "status"],
      "properties": {
        "request_id": {"type": "string", "format": "uuid"},
        "session_id": {"type": "string", "format": "uuid"},
        "decision": {"enum": ["allow", "deny", "modify", "ask", "defer", "service_unavailable"]},
        "executed": {"type": "boolean"},
        "outcome": {"enum": ["succeeded", "blocked", "failed"]},
        "policy_bound": {"type": "boolean"},
        "status": {"enum": ["pass", "fail", "inconclusive"]}
      }
    }},
    "brf_evidence_relevance": {"type": "array", "items": {"type": "string"}},
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
